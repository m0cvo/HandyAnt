@page "/weather"

<div class="cardBod">
    <h1>JPole</h1>

    <card width="60%">
        <label>Please enter freq in MHz: </label>
        <input @bind="f"></input> <br />
        <label for="input">Velocity Factor       : </label>
        <input @bind="v">Velocity Factor*: </input>
        <br /><br />
        <button class="btn btn-primary" @onclick="calcf">Calculate</button>
        <p><strong>@message</strong></p>

        <p>Wavelength in free space  : <strong>@wl</strong> m</p>
        <p>with velocity factor      : <strong>@wlv</strong> m</p>
        <p>Overall length (A)        : <strong>@a</strong> m</p>
        <p>1/4 Wave matching stub (B): <strong>@c</strong> m</p>
        <p>Feedpoint from bottom (C) : <strong>@d</strong> m</p>
        <p>Spacing                   : <strong>@s</strong> cm</p>

    </card>
    <div class="center">
        <img src="/images/JPole_Dim.png" height="400" />
    </div>

@code {
    string f = "0";
    double y;
    double fo;
    double v = 0.96;
    double wl;
    double wlv;
    double a;
    double c;
    double d;
    double s;
    string message = "";

    private async Task calcf()
    {
        bool canConvert = double.TryParse(f, out y);
        if (canConvert == true)
        {
            fo = y;
            wl = (300 / fo);
            var wlr = Math.Round(wl, 2);
            wl = wlr;
            wlv = (300 * v / fo);
            var wlvr = Math.Round(wlv, 2);
            wlv = wlvr;
            a = (300 * 0.75 / fo);
            var ar = Math.Round(a, 3);
            a = ar;
            c = (300 * 0.25 / fo);
            var cr = Math.Round(c, 3);
            c = cr;
            d = (300 * 0.025 / fo);
            var dr = Math.Round(d, 2);
            d = dr;
            s = (30000 * 0.02175 / fo);
            var sr = Math.Round(s, 1);
            s = sr;
        }
        else
        {
            message = "Please enter a valid number";
            await Task.Delay(4000);
            message = "";
        }
    }

}
</div>
